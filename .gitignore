# Root level gitignore

# Documents directory
documents/
*.md
!README.md

# Database files (you may want to exclude actual database files)
*.sql
!schema.sql
db/

# Environment variables
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# Temporary files
tmp/
*.tmp
*.swp

# Backup files
*.bak
*~

# Compiled files
*.class
*.o
*.so
*.exe
*.dll

# Node modules
node_modules/
# Python cache
__pycache__/

#Unwanted files
solo/
*.pem