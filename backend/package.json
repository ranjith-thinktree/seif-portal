{
  "name": "seif-portal-backend",
  "version": "1.0.1",
  "description": "SEIF Portal Backend API - Training Center Management System with Diagnostics",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:smoke": "jest tests/unit --runInBand --coverage=false",
    "lint": "eslint src/**/*.js",
    "lint:smoke": "node scripts/syntax-check.js",
    "format": "prettier --write \"src/**/*.js\"",
    "db:migrate": "node src/database/migrations/run-migrations.js",
    "db:seed": "node src/database/seeds/run-seeds.js"
  },
  "keywords": [
    "seif",
    "training",
    "portal",
    "api"
  ],
  "author": "SEIF Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@sentry/node": "^7.114.0",
    "@sentry/profiling-node": "^7.114.0",
    "archiver": "^5.3.2",
    "aws-sdk": "^2.1498.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.18.0",
    "react-toastify": "^11.0.5",
    "redis": "^4.6.11",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "string-similarity": "^4.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^4.17.21",
    "axios": "^1.13.5",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.1.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
